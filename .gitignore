# Données de test locales, potentiellement confidentielles.
# Seuls les README d'accueil sont publiables. Ne pas ajouter d'exception pour un corpus.
/tests/sources/*
!/tests/sources/README.md
/tests/runs/*
!/tests/runs/README.md
/tests/models/*
!/tests/models/README.md

# Défense si des données sont recopiées dans les anciens emplacements
/CorpusReel/
/CorpusSynth/
/runs/

